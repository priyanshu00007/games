{
  "name": "wizard-chess-aistudio-applet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node -e \"require('fs').existsSync('node_modules')||require('child_process').execSync('npm install',{stdio:'inherit'})\"",
    "dev": "vite --port=9000 --host=0.0.0.0",
    "prebuild": "node -e \"require('fs').existsSync('node_modules')||require('child_process').execSync('npm install',{stdio:'inherit'})\"",
    "build": "vite build",
    "prelint": "node -e \"require('fs').existsSync('node_modules')||require('child_process').execSync('npm install',{stdio:'inherit'})\"",
    "lint": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "chess.js": "^1.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.170.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.170.0",
    "typescript": "^7.0.2"
  }
}
